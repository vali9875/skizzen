        </mxCell>
        <mxCell id="snsYQgeQfZtFvuwurOEF-27" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Globales Gewicht des Kriteriums j:&lt;div&gt;Also wie stark das Gewicht&amp;nbsp;&amp;nbsp;&lt;/div&gt;" vertex="1">
