        <mxCell id="vII4pDCSPEioq7d3tG4C-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Problem mit RF Feature Importance ableitung:&lt;br&gt;diese muss nur global durchs AWM stimmen aber auf einer Task nicht zwangsweise&lt;div&gt;Beispiel:&lt;br&gt;. Bei &quot;Schnittstellen testen&quot; sollte Schnittstellen das dominierende Kriterium sein, nicht nur 10,8% beitragen.&lt;/div&gt;" vertex="1">
