        </mxCell>
        <mxCell id="snsYQgeQfZtFvuwurOEF-28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Beispiel mit den Referenzwerten:&amp;nbsp;&lt;div&gt;Eigentlich müsste man diese Refernzapplikation davor definieren also für die dann wie in der alten AWM-Version der Basisaufwand in jeder Task angegeben wird&amp;nbsp;&lt;/div&gt;&lt;div&gt;Also Angenommen wir haben gegen:&lt;/div&gt;&lt;div&gt;die anhand einer Referenzapplikation erstellten Basisaufwände in jedem AWM-Schritt&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;dann folgt daraus dass wir summiert über alle diese Aufwände zum&lt;b&gt; globalen Basisaufwand&lt;/b&gt; von x Stunden kommen&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;ANGENOMMEN&lt;/div&gt;&lt;div&gt;wir wissen aus der RF- Feature Importance analyse wie stark der globale Basisaufwand von den einzelnen Kriterien beeinflusst wird&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Also zb 502 h globaler Basisaufwand:&lt;/div&gt;&lt;div&gt;dann muss falls man die Kriterienwerte in das AWM eingibt auch am ende die 502 rauskommen durch die&lt;b&gt; Durchlauf-Rechnung&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="490" x="-230" y="-1010" as="geometry" />
        </mxCell>
        <mxCell id="snsYQgeQfZtFvuwurOEF-29" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="globale Durchlauf- Rechnung:&lt;div&gt;geg. Ausprägung der 10 Kriterien&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;start bei Task 0 : summe aus [Basisaufwand*Ausprägung_des_Kriteriums]&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="410" x="510" y="-990" as="geometry" />
        </mxCell>
        <mxCell id="snsYQgeQfZtFvuwurOEF-30" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Ausprägung_des_Kriteriums&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;muss eingebaut werden da sonst zb 100 User gleichwertig mit 100000 wären&amp;nbsp;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="590" x="1060" y="-970" as="geometry" />
        </mxCell>
        <mxCell id="snsYQgeQfZtFvuwurOEF-31" parent="1" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.flash" value="macht das b_i eigentlich redundant da wir es&amp;nbsp;&lt;div&gt;ja über die ausprägung steuern können&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="80" x="1610" y="-900" as="geometry" />
        </mxCell>
        <mxCell id="vII4pDCSPEioq7d3tG4C-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="$$\text{Aufwand}_{\text{App}} = \sum_{i=1}^{N} \left[ B_i \cdot \frac{\sum_{j} b_{ij} f_j}{\sum_{j}&amp;nbsp; b_{ij}} \right]$$" vertex="1">
          <mxGeometry height="80" width="300" x="710" y="330" as="geometry" />
        </mxCell>
        <mxCell id="vII4pDCSPEioq7d3tG4C-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;$$B_i = \text{Basisaufwand Task } i$$&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;$$b_{ij} = \text{Zuordnung Kriterium } j \text{ zu Task } i \in \{0,1\}$$&lt;/span&gt;&lt;/div&gt;&lt;div&gt;$$f_j = \text{Kostenband-Faktor App fur Kriterium } j, \quad f_j^{\text{ref}} = 1{,}0$$&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="380" x="670" y="390" as="geometry" />
        </mxCell>
        <mxCell id="vII4pDCSPEioq7d3tG4C-19" edge="1" parent="1" source="vII4pDCSPEioq7d3tG4C-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="vII4pDCSPEioq7d3tG4C-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vII4pDCSPEioq7d3tG4C-7" parent="1" style="whiteSpace=wrap;html=1;" value="Mapping notwendig in der Art dass paarweise unter Kriterien gleich:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;PBI_TO_FACTOR &lt;span class=&quot;token token&quot; style=&quot;color: rgb(20, 24, 31);&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;{&lt;/span&gt;&amp;nbsp;&lt;div&gt;    &lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 128, 0);&quot;&gt;&quot;&amp;lt;= 2 / Year&quot;&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;:&lt;/span&gt;   &lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 128, 128);&quot;&gt;0.25&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;,&lt;/span&gt;   &lt;span class=&quot;token token&quot; style=&quot;color: rgb(110, 118, 135);&quot;&gt;# XXS&lt;/span&gt;&amp;nbsp;&lt;div&gt;    &lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 128, 0);&quot;&gt;&quot;3-10 / Year&quot;&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;:&lt;/span&gt;   &lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 128, 128);&quot;&gt;0.75&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;,&lt;/span&gt;   &lt;span class=&quot;token token&quot; style=&quot;color: rgb(110, 118, 135);&quot;&gt;# XS&lt;/span&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;    &lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 128, 0);&quot;&gt;&quot;11-20 / Year&quot;&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;:&lt;/span&gt;  &lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 128, 128);&quot;&gt;1.0&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;,&lt;/span&gt;    &lt;span class=&quot;token token&quot; style=&quot;color: rgb(110, 118, 135);&quot;&gt;# S  (Referenz)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;    &lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 128, 0);&quot;&gt;&quot;21-40 / Year&quot;&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;:&lt;/span&gt;  &lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 128, 128);&quot;&gt;1.2&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;,&lt;/span&gt;    &lt;span class=&quot;token token&quot; style=&quot;color: rgb(110, 118, 135);&quot;&gt;# M&lt;/span&gt;&lt;/div&gt;&lt;div&gt;    &lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 128, 0);&quot;&gt;&quot;41-120 / Year&quot;&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;:&lt;/span&gt; &lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 128, 128);&quot;&gt;1.75&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;,&lt;/span&gt;   &lt;span class=&quot;token token&quot; style=&quot;color: rgb(110, 118, 135);&quot;&gt;# L&lt;/span&gt;&lt;/div&gt;&lt;div&gt;    &lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 128, 0);&quot;&gt;&quot;&amp;gt; 120 / Year&quot;&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;:&lt;/span&gt;  &lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 128, 128);&quot;&gt;2.1&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;,&lt;/span&gt;    &lt;span class=&quot;token token&quot; style=&quot;color: rgb(110, 118, 135);&quot;&gt;# XL&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;}&lt;/span&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
