        <mxCell id="snsYQgeQfZtFvuwurOEF-25" parent="1" style="whiteSpace=wrap;html=1;shape=mxgraph.basic.roundRectCallout;dx=15;dy=26;size=5;boundedLbl=1;" value="Ich will Applikation XY bewertet haben:&lt;div&gt;Die App hat&amp;nbsp;&lt;/div&gt;&lt;div&gt;PBI: 20&lt;/div&gt;&lt;div&gt;Interfaces: 2&lt;/div&gt;&lt;div&gt;Changes letztes Jahr: 4&lt;/div&gt;&lt;div&gt;Monitoring Effort: 5 h&lt;/div&gt;&lt;div&gt;...&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
